@model LMSystem.ViewModels.LibrarianIndexViewModel
@{
    ViewData["Title"] = "Librarians";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>👔 Librarians</h2>
    <a href="/Librarian/Create" class="btn btn-dark">+ Add Librarian</a>
</div>

<form method="get" action="/Librarian/Index" class="mb-4">
    <div class="input-group" style="max-width:400px;">
        <input type="text" name="searchTerm" class="form-control" placeholder="Search by name..." value="@Model.SearchTerm" />
        <button class="btn btn-outline-dark" type="submit">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a href="/Librarian/Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Librarians.Any())
{
    <div class="alert alert-info">No librarians found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Age</th>
                    <th>Phone</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lib in Model.Librarians)
                {
                    <tr>
                        <td>@lib.LibrarianId</td>
                        <td>@lib.Name</td>
                        <td>@lib.Age</td>
                        <td>@lib.Phone</td>
                        <td>
                            <a href="/Librarian/Edit/@lib.LibrarianId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <a href="/Librarian/Delete/@lib.LibrarianId" class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Are you sure you want to delete this librarian?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="/Librarian/Index?page=@i&searchTerm=@Model.SearchTerm">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
